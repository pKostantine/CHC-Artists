{
  "expo": {
    "name": "CHC Artists",
    "slug": "chc-artists",
    "version": "0.1.0",
    "orientation": "default",
    "icon": "./assets/images/CHC_Artists_App.png",
    "scheme": "chcartists",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "ios": {
      "icon": "./assets/images/CHC_Artists_App.png",
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#11161B",
        "foregroundImage": "./assets/images/CHC_Artists_App.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/CHC_Artists_sm_web.png"
    },
    "splash": {
      "backgroundColor": "#11161B",
      "image": "./assets/images/CHC_Artists_App.png",
      "resizeMode": "contain"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
