{
  "expo": {
    "name": "CHC Artists",
    "slug": "chc-artists",
    "version": "0.1.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-sqlite"
    ],
    "scheme": "chcartists"
  }
}
