{
  "name": "chc-artists",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "deploy": "npm run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test:submissions": "node --test tests/submissionIdentity.test.cjs",
    "test:mobile-files": "node --test tests/mobileFilePickers.test.cjs",
    "test": "npm run test:submissions && npm run test:mobile-files"
  },
  "dependencies": {
    "@expo/ui": "57.0.18",
    "@supabase/supabase-js": "2.112.1",
    "expo": "^57.0.21",
    "expo-asset": "57.0.16",
    "expo-audio": "57.0.5",
    "expo-constants": "~57.0.18",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-sharing": "57.0.20",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "57.0.1",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.0",
    "expo-notifications": "~57.0.20"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "6.0.3",
    "wrangler": "^4.133.0"
  }
}
