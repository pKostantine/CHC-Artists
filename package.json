{
  "name": "chc-artists",
  "version": "0.1.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export -p web",
    "deploy": "npm run build && wrangler deploy",
    "deploy:pages": "npm run build && wrangler pages deploy dist --project-name chc-artists",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.112.1",
    "expo": "57.0.21",
    "expo-audio": "57.0.5",
    "expo-document-picker": "57.0.2",
    "expo-file-system": "57.0.7",
    "expo-sharing": "57.0.20",
    "expo-status-bar": "57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0",
    "react-native-url-polyfill": "3.0.0",
    "react-native-web": "0.21.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "typescript": "6.0.3",
    "wrangler": "^4.133.0"
  }
}
