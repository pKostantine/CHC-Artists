# Optional overrides for the public CHC Artists client configuration.
# The app already contains the live CHC Supabase URL and publishable key, so a
# fresh clone can run in Expo Go or on web without creating .env.local.
# Copy this file to .env.local only when you want to override those defaults.

EXPO_PUBLIC_SUPABASE_URL=https://wtuujmeinzqfikvuofmh.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_H0lG0vRL6io4Uy0htd77Cw_dlNbwx0n

# Legacy compatibility only. If set, this is used after the publishable-key
# variable above and before the built-in default.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The chc-media-resolver Worker. Swap for a custom media domain if one is set up.
EXPO_PUBLIC_CHC_MEDIA_BASE_URL=https://chc-media-resolver.hrmpdd8d6c.workers.dev

EXPO_PUBLIC_CHC_UPLOAD_URL=https://chc-upload-authorizer.hrmpdd8d6c.workers.dev
