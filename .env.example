# Copy this file to .env.local and fill in the anon key. Everything else is
# already pointed at the live CHC services. .env.local is gitignored, so a
# fresh clone always starts without one -- the app throws on load until it
# exists, because these values are compiled in rather than read at runtime.

EXPO_PUBLIC_SUPABASE_URL=https://wtuujmeinzqfikvuofmh.supabase.co

# Supabase → Project Settings → API → anon/public key. Not committed.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# The chc-media-resolver Worker. Swap for a custom media domain if one is set up.
EXPO_PUBLIC_CHC_MEDIA_BASE_URL=https://chc-media-resolver.hrmpdd8d6c.workers.dev

EXPO_PUBLIC_CHC_UPLOAD_URL=https://chc-upload-authorizer.hrmpdd8d6c.workers.dev
